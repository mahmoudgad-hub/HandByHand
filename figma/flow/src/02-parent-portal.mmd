  SITE["الموقع التعريفي العام<br/>site/ — بلا مصادقة ولا API"]:::public
  APPLY["/apply<br/>الطريق الوحيد بلا حارس<br/>الكتابة الوحيدة بلا مصادقة في الخدمة"]:::public

  LOGIN["/login<br/>guestOnlyGuard"]:::auth
  OTP["/login/otp<br/>رمز لمرّة واحدة"]:::auth
  G1{{"authGuard"}}:::guard
  WELCOME["/welcome<br/>اختيار الطفل"]:::auth
  G2{{"childSelectedGuard"}}:::guard

  SHELL["الهيكل — الرأس وشريط التبويبات"]:::auth

  HOME["/home<br/>تبويب"]:::tab
  SCHED["/schedule<br/>تبويب"]:::tab
  PROG["/progress<br/>تبويب"]:::tab
  ACT["/activities<br/>تبويب — البرنامج المنزلي"]:::tab
  LIVE["/live<br/>بثّ الجلسة — عودة إلى /home"]:::auth
  REPS["/reports<br/>تبويب"]:::tab
  REP["/reports/:reportId<br/>عودة إلى /reports لا إلى /home"]:::auth
  BILL["/billing<br/>تبويب — لا يحتاج طفلًا مختارًا"]:::tab
  REQ["/requests<br/>تبويب — لا يحتاج طفلًا مختارًا"]:::tab
  THER["/therapists/:therapistId<br/>المعرّف في المسار — عضو طاقم لا بيانات طفل"]:::auth
  PROF["/profile<br/>تبويب"]:::tab
