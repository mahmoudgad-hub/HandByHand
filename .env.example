# Local development secrets. Copy to deploy/compose/.env and change the
# values. .env is git-ignored and must never be committed.
#
# COPY IT TO deploy/compose/.env AND NOT TO THE DIRECTORY THIS FILE IS IN.
# The scripts run `docker compose -f deploy/compose/docker-compose.yml`,
# and compose takes its project directory from the compose file - so the
# `.env` it loads is the one NEXT TO THAT FILE. A `.env` placed here, beside
# this example, is read by nothing and reports nothing: every variable keeps
# its default, the service starts, and the setting you are certain you set is
# simply absent. Verified by putting a different value in each location and
# asking `docker compose config` which one it saw.

# ---- Database ----
DB_OWNER_PASSWORD=hbh_dev_only_change_me
DB_APP_PASSWORD=hbh_app_dev_only_change_me
DB_PORT=5434

# The interface the published ports answer on. Every interface is right
# on a developer machine behind a router and wrong on a host with a
# public address - there it is 127.0.0.1, and the ports are reached
# through an SSH tunnel.
BIND_ADDR=0.0.0.0

# ---- API ----
# 8080, 8081 and 8088 are already taken on this machine.
API_PORT=8090
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4200

# Returns the one-time code in the HTTP response, so the acceptance suite
# has a way to learn it on a machine with no provider account.
# The service REFUSES TO START with this on unless APP_ENV=development.
OTP_ECHO=true
MAINTENANCE_INTERVAL_SECONDS=3600

# ---- SMS delivery ----
#
# TWO RULES, AND BOTH ARE REFUSALS AT STARTUP RATHER THAN WARNINGS.
#
#   OTP_ECHO=true      with APP_ENV != development  -> will not start
#   SMS_PROVIDER=dev   with APP_ENV != development  -> will not start
#
# The second one is the half that was missing until C5, and it is the one
# that matters more. Turning OTP_ECHO off without a provider does not make
# production safe - it makes production UNUSABLE and quiet: every login
# accepted, every code generated and thrown away, and a service reporting
# itself healthy while no parent can sign in. There is no log line for
# "nobody can authenticate". So the pair is: a production process has a
# real delivery channel, or it does not start.
#
# dev   accepts every message and sends nothing. Right on a laptop,
#       catastrophic anywhere else, and refused anywhere else.
# http  a real provider behind a form POST. NO PROVIDER IS CONTRACTED
#       YET - docs/architect/01-proposals.md 0.2 names Vodafone Bulk and
#       SMSMisr as candidates and says the contract takes longer than the
#       code. Fill these in when one is signed.
SMS_PROVIDER=dev

# Never commit real values. SMS_HTTP_PASSWORD is a secret and does not
# reach the database, the logs, or hbh.sms_outbox.error_detail.
#SMS_HTTP_URL=https://gateway.example.eg/send
#SMS_HTTP_USERNAME=
#SMS_HTTP_PASSWORD=
#SMS_HTTP_SENDER_ID=HBH

# Providers disagree about what they call these fields, and that is the
# difference between supporting one and supporting the next. Leave unset
# for the common defaults (username, password, sender, mobile, message).
#SMS_HTTP_FIELD_USERNAME=
#SMS_HTTP_FIELD_PASSWORD=
#SMS_HTTP_FIELD_SENDER=
#SMS_HTTP_FIELD_TO=
#SMS_HTTP_FIELD_BODY=

# twilio_whatsapp  delivery over WhatsApp. Never commit real values:
# TWILIO_AUTH_TOKEN is a secret and does not belong in this file.
#
# WHY A TEMPLATE IS NOT OPTIONAL. A WhatsApp message the centre STARTS -
# every message this service sends - may only be an approved template,
# named by its ContentSid. Free text is refused by WhatsApp with error
# 63016 on every attempt, so a missing mapping is a CONFIG failure and
# not something a retry fixes. config.Load refuses to start a production
# process whose TWILIO_CONTENT_SIDS has no OTP_LOGIN entry, because that is the
# one message whose absence closes the front door.
#
# TWILIO_CONTENT_SIDS is CODE=SID pairs, comma separated. The code is
# hbh.sms_outbox.template_code, SPELLED EXACTLY AS THE OUTBOX ROW SPELLS
# IT: OTP_LOGIN for a login code, and the notification kind for everything
# else. Several codes may share one SID. The name matters - reading the
# outbox and mapping what you see there is the only way an operator can
# know what to fill in, so anything else here is a refusal nobody can
# explain.
##SMS_PROVIDER=twilio_whatsapp
#TWILIO_ACCOUNT_SID=AC...
#TWILIO_AUTH_TOKEN=
# One of these two. A messaging service carries sender selection with it
# and is the better choice once there is more than one number.
#TWILIO_WHATSAPP_FROM=+20...
#TWILIO_MESSAGING_SERVICE_SID=MG...
#TWILIO_CONTENT_SIDS=OTP_LOGIN=HX...,APPOINTMENT_BOOKED=HX...,ENROLMENT_ASSESSMENT=HX...,APPOINTMENT_REMINDER=HX...,APPOINTMENT_REMINDER_RESCHEDULED=HX...
# Optional. Where Twilio reports what happened after it accepted a
# message. Nothing in this service reads it yet.
#TWILIO_STATUS_CALLBACK=

# DEVELOPMENT ONLY, and the service REFUSES TO START with it set when
# APP_ENV is not development - the same rule as OTP_ECHO above.
#
# With it on, a template code that has no ContentSid sends its rendered
# Arabic instead of refusing. That is useful in exactly one place:
# Twilio's WhatsApp sandbox, which opens a 24-hour session when a tester
# sends it the join word, and inside that window free text is delivered.
# It lets you watch a login code reach a real handset before Meta has
# approved a template, which is otherwise a wait of days.
#
# It is useless anywhere else and that is why it is fenced. Every message
# this centre sends is one the centre started, so it is outside any
# session, and WhatsApp refuses free text there with error 63016 - the
# same refusal every time. The fallback would climb the whole retry
# ladder, deliver nothing, and leave failures naming a template rather
# than the approval nobody requested.
#TWILIO_ALLOW_FREEFORM=true

# How often the outbox is drained, and how many messages one pass takes.
# Neither is a business value: what to send, when to give up and how long
# to wait between attempts are decided in PL/pgSQL (SMS_MAX_ATTEMPTS,
# SMS_RETRY_BASE_SECONDS, SMS_STUCK_MINUTES in hbh.sys_params).
SMS_WORKER_SECONDS=5
SMS_WORKER_BATCH=20

# ---- Development staff accounts ----
# Used ONLY by: bash scripts/db.sh dev-user
#
# Creates dev_admin (CENTER_ADMIN) and dev_reception (RECEPTION) so the
# operations console has something to sign in as. It is NOT part of
# migrate and the file lives in db/dev/, not db/seed/ - every file in
# db/seed/ runs on every install, so a staff password there would be
# created on production too, written in the repository.
#
# There is no default. Minimum 12 characters.
DEV_STAFF_PASSWORD=hbh_dev_console_change_me

# ---------------------------------------------------------------------
# The video for an online consultation.
#
# JITSI_PUBLIC is meet.jit.si: no account, no token, and the room name is
# the only credential there is. Right on a laptop; every attempt to enter
# a consultation answers 503 in production, and hbhd says so at startup.
#
# JITSI_JAAS is hosted Jitsi with a per-participant token, free to 25
# monthly active users. A "monthly active user" is every participant who
# joins - so the therapist counts once a month and each family once.
# ---------------------------------------------------------------------
MEETING_PROVIDER=JITSI_PUBLIC
# MEETING_JAAS_APP_ID=vpaas-magic-cookie-…
# MEETING_JAAS_KEY_ID=vpaas-magic-cookie-…/abc123
# MEETING_JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# …
# -----END PRIVATE KEY-----"
